APP_ENV=production
APP_NAME=Devnotation
APP_URL=https://devnotation.com

# Private destination. Never put this value in public HTML/JS.
MAIL_TO_ADDRESS=your-private-email@example.com

# SMTP
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@devnotation.com
MAIL_FROM_NAME=Devnotation Website

# Optional Cloudflare Turnstile
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Basic file rate limiting
RATE_LIMIT_WINDOW=900
RATE_LIMIT_MAX_REQUESTS=5
